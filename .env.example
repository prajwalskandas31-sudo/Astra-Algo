# .env Template
# Add this file to both your frontend and backend (or keep a unified one depending on deployment).
# Here are the required APIs for the Trading App.

# --- Backend Configuration ---
SECRET_KEY=your_fastapi_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=sqlite:///./trading.db # Replace with PostgreSQL or other production DB if needed

# Security
# Comma-separated list of allowed IPs. Example: 192.168.1.100,203.0.113.1
ALLOWED_STATIC_IPS=127.0.0.1,localhost

# Trading Data & Broker API (e.g., Zerodha Kite, Upstox, AliceBlue, etc.)
BROKER_API_KEY=your_broker_api_key_here
BROKER_API_SECRET=your_broker_api_secret_here
BROKER_ACCESS_TOKEN=your_broker_access_token_here

# Telegram Alerts
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Frontend Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Trading engine ---
# paper (default): no broker orders; trades simulated on real 1-min candles.
# live: real Upstox orders (only with a valid token, Upstox data, 09:15-09:45 entry window).
TRADING_MODE=paper
ORDER_QUANTITY=1                 # fixed qty when RISK_PER_TRADE_INR is 0
RISK_PER_TRADE_INR=0             # e.g. 1000 -> qty = floor(1000 / (high - low))
MAX_CAPITAL_PER_TRADE_INR=0      # e.g. 100000 -> caps qty by notional; 0 = no cap
MAX_LIVE_TRADES_PER_DAY=10
ENTRY_LIMIT_BUFFER_PCT=0.10      # stop-limit slack above the 09:15 high

# AI strategy drafting (optional)
GEMINI_API_KEY=
